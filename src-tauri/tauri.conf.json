{
  "productName": "Yama Print",
  "version": "0.1.0",
  "identifier": "com.yamaprint.app",
  
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yama Print",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "headerImage": "../public/logo.png",
        "sidebarImage": "../public/logo.png"
      }
    }
  }
}